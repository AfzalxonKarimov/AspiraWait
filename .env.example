# Aspira Waitlist — Environment Variables (Template)
# ========================================
# Copy this file to `.env` and fill in your real Supabase credentials.
# Get them from https://supabase.com → your project → Project Settings → API
#
#   cp .env.example .env

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
